# Copie para .env e ajuste se precisar.
DATABASE_URL=postgres://otilc:otilc@localhost:5432/otilc
# Certificado raiz público do Supabase (conteúdo PEM). Com ele, a conexão usa SSL verificando
# o certificado. Obrigatório em produção; no Postgres local deixe vazio.
DATABASE_CA_CERT=
PORT=3333
# Origem da loja que pode chamar a API (CORS). Em produção: só a origem, com https e sem barra
# no fim (ex. fictício: https://loja.example.com).
WEB_ORIGIN=http://localhost:3000
# Minutos que um pedido segura o estoque enquanto espera o pagamento.
ORDER_HOLD_MINUTES=30
# Intervalo (ms) da conciliação do Pix com o Mercado Pago: de 30000 a 3600000. Padrão: 5 min.
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
# Pix com Mercado Pago (sandbox). Sem as três, o Pix fica desligado fora de produção
# (a loja mostra "Pix indisponível"); em produção a API não sobe sem elas.
# Os valores reais vão só no .env, nunca no repositório. Os abaixo são fictícios.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública (https) que o Mercado Pago chama. Em dev, um túnel apontando para a API.
MP_NOTIFICATION_URL=
# Exemplo de formato (fictício):
# MP_ACCESS_TOKEN=TEST-0000000000000000-000000-ficticio-000000000
# MP_WEBHOOK_SECRET=segredo-ficticio-gere-no-painel-do-mercado-pago
# MP_NOTIFICATION_URL=https://seu-tunel.example.com/api/webhooks/mercadopago
