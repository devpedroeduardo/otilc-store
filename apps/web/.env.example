# Endereço da API que o servidor do Next.js usa para buscar o catálogo.
API_URL=http://localhost:3333
# Endereço da API que o navegador usa para criar pedidos.
NEXT_PUBLIC_API_URL=http://localhost:3333
# Use 1 apenas no desenvolvimento sem API, para carregar dados de exemplo.
NEXT_PUBLIC_ADMIN_MOCK=0
